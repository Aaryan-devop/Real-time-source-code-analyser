# CodePulse Configuration
# Copy to .env and modify as needed

# Server
CODEPULSE_HOST=127.0.0.1
CODEPULSE_PORT=8000

# File Watcher
CODEPULSE_DEBOUNCE_MS=300
CODEPULSE_MAX_FILE_SIZE_KB=1024
CODEPULSE_IGNORE_PATTERNS=.git,node_modules,__pycache__,venv,.venv,dist,build,.idea,.vscode

# Health Score Weights
CODEPULSE_WEIGHT_CRITICAL=10
CODEPULSE_WEIGHT_HIGH=5
CODEPULSE_WEIGHT_MEDIUM=2
CODEPULSE_WEIGHT_LOW=0.5
CODEPULSE_WEIGHT_INFO=0

# Ollama (optional, local AI explainer)
CODEPULSE_OLLAMA_URL=http://localhost:11434
CODEPULSE_OLLAMA_MODEL=qwen2.5-coder:1.5b
CODEPULSE_OLLAMA_TIMEOUT=15

# CORS (Vite dev server)
CODEPULSE_CORS_ORIGIN=http://localhost:5173
