# GEMINI_API_KEY: Optional API key injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# CodePulse Server & Database Configuration
CODEPULSE_DB_PATH="codepulse.db"
CODEPULSE_DEBOUNCE_MS="300"
CODEPULSE_MAX_FILE_SIZE_BYTES="1048576"

# Optional Local Ollama Explainer (offline local-only endpoint)
CODEPULSE_OLLAMA_URL="http://127.0.0.1:11434"
CODEPULSE_OLLAMA_MODEL="qwen2.5-coder:1.5b"

# Health Score Severity Penalty Weights
CODEPULSE_WEIGHT_CRITICAL="10.0"
CODEPULSE_WEIGHT_HIGH="5.0"
CODEPULSE_WEIGHT_MEDIUM="2.0"
CODEPULSE_WEIGHT_LOW="0.5"
